{
  "name": "my-home",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:my-home": "node dist/my-home/server/server.mjs",
    "images": "node scripts/optimize-images.mjs",
    "og": "ng build && node scripts/og-image.mjs",
    "icons": "node scripts/icons.mjs",
    "seo-files": "node scripts/seo-files.mjs",
    "assets": "npm run images && npm run seo-files && npm run og"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.7",
    "@fontsource-variable/mulish": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "compression": "^1.8.2",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.1",
    "@types/node": "^22.12.0",
    "jsdom": "^30.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "puppeteer-core": "^25.16.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
